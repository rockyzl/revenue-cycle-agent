                  "id": "_Implicit_Edge__Implicit_Gateway_prepareDraft__Implicit_EndEvent_{branchName}_prepareDraft",
                  "source": "_Implicit_Gateway_prepareDraft",
                  "target": "_Implicit_EndEvent_{branchName}_prepareDraft",
                  "type": "bpmn:SequenceFlow",
                  "data": {
                    "conditionExpression": "{branch.conditionExpression}",
                    "label": "{branch.name}"
                  }
                },
                {
                  "condition": "node.data.inputs.branches.length > 0",
                  "id": "_Implicit_Edge__Implicit_Gateway_prepareDraft__Implicit_EndEvent_Default_prepareDraft",
                  "source": "_Implicit_Gateway_prepareDraft",
                  "target": "_Implicit_EndEvent_Default_prepareDraft",
                  "type": "bpmn:SequenceFlow",
                  "data": {
                    "label": "Default"
                  }
                },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_Edge__Implicit_BoundaryError_prepareDraft__Implicit_EndEvent_Failure_prepareDraft",
                  "source": "_Implicit_BoundaryError_prepareDraft",
                  "target": "_Implicit_EndEvent_Failure_prepareDraft",
                  "type": "bpmn:SequenceFlow",
                  "data": {}
                }
              ]
            },
            {
              "id": "_Implicit_PostSubprocessGateway_prepareDraft",
              "type": "bpmn:ExclusiveGateway",
              "condition": "(node.data.inputs.branches.length > 0 || hasEdgeFromHandle('error')) && originalEdges.length > 0",
              "parentId": null,
              "position": {
                "x": 0,
                "y": 0
              },
              "data": {
                "label": "Post-Subprocess Branch"
              }
            }
          ],
          "edges": [
            {
              "condition": "(node.data.inputs.branches.length > 0 || hasEdgeFromHandle('error')) && originalEdges.length > 0",
              "id": "_Implicit_Edge_prepareDraft__Implicit_PostSubprocessGateway_prepareDraft",
              "source": "prepareDraft",
              "target": "_Implicit_PostSubprocessGateway_prepareDraft",
              "type": "bpmn:SequenceFlow",
              "data": {}
            },
            {
              "forEach": "node.data.inputs.branches",
              "condition": "node.data.inputs.branches.length > 0",
              "matchOriginalEdgeByHandle": "branch-{branch.id}",
              "preserveEdgeId": true,
              "source": "_Implicit_PostSubprocessGateway_prepareDraft",
              "type": "bpmn:SequenceFlow",
              "data": {
                "conditionExpression": "{branch.conditionExpression}",
                "label": "{branch.name}"
              }
            },
            {
              "condition": "node.data.inputs.branches.length > 0 || hasEdgeFromHandle('error')",
              "matchOriginalEdgeByHandle": "default",
              "preserveEdgeId": true,
              "source": "_Implicit_PostSubprocessGateway_prepareDraft",
              "type": "bpmn:SequenceFlow",
              "data": {
                "label": "Default"
              }
            },
            {
              "condition": "hasEdgeFromHandle('error')",
              "matchOriginalEdgeByHandle": "error",
              "preserveEdgeId": true,
              "source": "_Implicit_PostSubprocessGateway_prepareDraft",
              "type": "bpmn:SequenceFlow",
              "data": {
                "conditionExpression": "=js:vars.prepareDraft.error || vars.prepareDraft.output?.statusCode >= 400",
                "label": "Error"
              }
            },
            {
              "condition": "node.data.inputs.branches.length === 0 && !hasEdgeFromHandle('error')",
              "matchOriginalEdgeByHandle": "default",
              "preserveEdgeId": true,
              "source": "prepareDraft",
              "type": "bpmn:SequenceFlow"
            }
          ]
        }
