                        {
                          "name": "response",
                          "type": "json",
                          "source": "=response",
                          "var": "response",
                          "internal": true
                        }
                      ]
                    }
                  }
                },
                {
                  "id": "_Implicit_Gateway_prepareDraft",
                  "type": "bpmn:ExclusiveGateway",
                  "parentId": "prepareDraft",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "condition": "node.data.inputs.branches.length > 0",
                  "data": {
                    "label": "Response branch",
                    "defaultFlowId": "_Implicit_Edge__Implicit_Gateway_prepareDraft__Implicit_EndEvent_Default_prepareDraft"
                  }
                },
                {
                  "forEach": "node.data.inputs.branches",
                  "id": "_Implicit_EndEvent_{branchName}_prepareDraft",
                  "type": "bpmn:EndEvent",
                  "parentId": "prepareDraft",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "{branch.name}"
                  }
                },
                {
                  "id": "_Implicit_EndEvent_Default_prepareDraft",
                  "type": "bpmn:EndEvent",
                  "parentId": "prepareDraft",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "Default"
                  }
                },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_EndEvent_Failure_prepareDraft",
                  "type": "bpmn:EndEvent",
                  "parentId": "prepareDraft",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "Failure",
                    "model": {
                      "serviceType": "BPMN.Variables",
                      "outputs": [
                        {
                          "name": "error",
                          "type": "boolean",
                          "source": "=true",
                          "var": "error",
                          "internal": true
                        }
                      ]
                    }
                  }
                },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_BoundaryError_prepareDraft",
                  "type": "bpmn:BoundaryEvent",
                  "parentId": "prepareDraft",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "Error",
                    "cancelActivity": false,
                    "attachedToId": "_Implicit_HttpTask_prepareDraft",
                    "eventDefinition": {
                      "type": "bpmn:ErrorEventDefinition",
                      "id": "_Implicit_BoundaryError_prepareDraft_Error"
                    },
                    "model": {
                      "outputs": [
                        {
                          "name": "Error",
                          "type": "jsonSchema",
                          "source": "=Error",
                          "var": "response",
                          "internal": true
                        }
                      ]
                    }
                  }
                }
              ],
              "edges": [
                {
                  "id": "_Implicit_Edge__Implicit_StartEvent_prepareDraft__Implicit_HttpTask_prepareDraft",
                  "source": "_Implicit_StartEvent_prepareDraft",
                  "target": "_Implicit_HttpTask_prepareDraft",
                  "type": "bpmn:SequenceFlow",
                  "data": {}
                },
                {
                  "condition": "node.data.inputs.branches.length === 0",
                  "id": "_Implicit_Edge__Implicit_HttpTask_prepareDraft__Implicit_EndEvent_Default_prepareDraft",
                  "source": "_Implicit_HttpTask_prepareDraft",
                  "target": "_Implicit_EndEvent_Default_prepareDraft",
                  "type": "bpmn:SequenceFlow",
                  "data": {}
                },
                {
                  "condition": "node.data.inputs.branches.length > 0",
