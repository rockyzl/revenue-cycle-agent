      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "approvedReply": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      },
      "inputs": {
        "title": {
          "type": "jsExpression",
          "expression": "`RC ${$vars.start.output.inquiryId}`",
          "fieldType": "string"
        },
        "priority": "Low",
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "user",
            "value": "zhanglu77@gmail.com"
          }
        },
        "schema": {
          "schemaId": "b2c7db76-589e-5c85-8932-66fc6df86178",
          "fields": [
            {
              "id": "question",
              "label": "患者消息（虚构演示）",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareDraft.output.body.message"
            },
            {
              "id": "evidence",
              "label": "账单、保险记录与检查结果",
              "type": "string",
              "direction": "input",
              "binding": "vars.prepareDraft.output.body.evidence"
            },
            {
              "id": "approvedReply",
              "label": "审核后回复",
              "type": "string",
              "direction": "inOut",
              "binding": "vars.prepareDraft.output.body.reply",
              "required": true,
              "controlType": "textarea"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      }
    },
