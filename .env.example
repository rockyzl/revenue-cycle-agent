GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
BILLING_MODE=vertex
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=false
# Set BILLING_MODE=vertex for real Vertex model calls.
# Optional local fallback: BILLING_USE_GCLOUD_AUTH=true
# UiPath cloud setup is separate; never commit access tokens.
